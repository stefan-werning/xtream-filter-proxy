# Copy to `backup.env` (git-ignored) and edit. backup.sh sources it.
# Every line here is optional; the defaults in backup.sh are used otherwise.

# How many gzipped copies to keep.
# LOCAL_KEEP=3
# REMOTE_KEEP=14

# --- Remote target: pick ONE of the two styles ---

# (a) An already-mounted path -- NFS, sshfs, a USB disk, etc.
# REMOTE_DIR=/mnt/nas/backups/xtream-filter-proxy

# (b) An SMB/CIFS share, mounted per-run. Needs passwordless
#     `sudo mount -t cifs` for the cron user (see README "Backups").
#     SMB_HOST is pinged first; if it's down the push is skipped.
# SMB_HOST=192.168.1.50
# SMB_SHARE=//192.168.1.50/public
# SMB_SUBDIR=Backup/xtream-filter-proxy
# SMB_OPTS=guest,vers=3.0,uid=1000,gid=1000
# SMB_MNT=/mnt/xtream-backup
